generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int    @id @default(autoincrement())
  discordId String @unique
  nickname  String
  wins      Int    @default(0)
  losses    Int    @default(0)

  tournamentWins Int @default(0)

  matches1 Match[] @relation("Player1")
  matches2 Match[] @relation("Player2")

  seasonSnapshots SeasonPlayerSnapshot[]
}

model Match {
  id Int @id @default(autoincrement())

  player1Id Int
  player2Id Int

  faction1 String
  faction2 String

  player1 Player @relation("Player1", fields: [player1Id], references: [id])
  player2 Player @relation("Player2", fields: [player2Id], references: [id])

  score1 Int
  score2 Int

  map String

  seasonId Int?
  season   Season? @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())
}

model Tournament {
  id     Int    @id @default(autoincrement())
  name   String
  status String @default("active")

  seasonId Int?
  season   Season? @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches TournamentMatch[]
}

model TournamentMatch {
  id           Int @id @default(autoincrement())
  tournamentId Int

  matchNumber Int
  round       String
  roundOrder  Int
  matchOrder  Int

  player1Id   String?
  player1Name String?
  player2Id   String?
  player2Name String?

  score1 Int?
  score2 Int?

  winnerId   String?
  winnerName String?

  loserNextMatchNumber Int?
  loserNextSlot        Int?

  status String @default("upcoming")

  nextMatchNumber Int?
  nextSlot        Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, matchNumber])
}

model Season {
  id       Int       @id @default(autoincrement())
  name     String
  status   String    @default("active") // active | completed
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  matches     Match[]
  tournaments Tournament[]
  snapshots   SeasonPlayerSnapshot[]
}

model SeasonPlayerSnapshot {
  id       Int @id @default(autoincrement())
  seasonId Int
  playerId Int

  rank           Int
  wins           Int
  losses         Int
  points         Int
  tournamentWins Int
  mainFaction    String?

  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([seasonId, playerId])
}
